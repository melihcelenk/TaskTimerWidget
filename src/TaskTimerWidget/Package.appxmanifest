<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp uap3 rescap">

  <Identity
    Name="MelihCelenk.TaskTimerWidget"
    Publisher="CN=5D40719C-2D85-4271-9B5B-116472554ADA"
    Version="1.1.0.0" />

  <Properties>
    <DisplayName>Task Timer Widget</DisplayName>
    <PublisherDisplayName>Melih Celenk</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="tr-tr" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Task Timer Widget"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="A lightweight, minimal task timer widget for Windows 11."
        BackgroundColor="#D0D0D0">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\LargeTile.png" Square71x71Logo="Assets\SmallTile.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo"/>
            <uap:ShowOn Tile="wide310x150Logo"/>
            <uap:ShowOn Tile="square310x310Logo"/>
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#D0D0D0" />
      </uap:VisualElements>
      <Extensions>
        <!-- Widget family (MEW-5): opened by the hub through this protocol. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="tasktimer-widget">
            <uap:DisplayName>Task Timer Widget</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <!-- Widget family (MEW-5): lets the hub find this app. Contract: external/WidgetFamily/docs/CONTRACT.md. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.melihcelenk.widgetfamily"
                             Id="tasktimer"
                             DisplayName="Task Timer Widget"
                             Description="Task timer"
                             PublicFolder="Public">
            <uap3:Properties>
              <Protocol>tasktimer-widget</Protocol>
              <PreferredEdge>Right</PreferredEdge>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
